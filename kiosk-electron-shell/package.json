{
  "name": "kiosk-electron-shell",
  "version": "1.0.0",
  "description": "Kiosk Electron Shell for Bus Information Display",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node build.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.18.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "fs-extra": "^11.2.0"
  },
  "build": {
    "appId": "com.company.businfodisplay",
    "productName": "Bus Info Display",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "www",
        "to": "www",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
