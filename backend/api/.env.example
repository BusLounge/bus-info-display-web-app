# Copy this file to .env and fill in the values (ask the team for them).
# .env is not committed.

PORT=8083

# PostgreSQL connection string, e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=
DATABASE_MAX_CONNECTIONS=10
DATABASE_MAX_IDLE_CONNECTIONS=5
DATABASE_CONN_MAX_LIFETIME=300

# Long random strings
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional token lifetimes in seconds (defaults: 3600 and 604800)
# JWT_ACCESS_TOKEN_EXPIRY=3600
# JWT_REFRESH_TOKEN_EXPIRY=604800

# Admin login for the admin web app
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# Optional
# MEDIA_DIR=../local-store/media
# Python ETA engine (backend/eta_engine). Off by default: it needs trained model files.
# ETA_ENGINE_ENABLED=false
# ETA_ENGINE_URL=http://localhost:8000
# TRIP_GENERATOR_TIMEZONE=Asia/Colombo
