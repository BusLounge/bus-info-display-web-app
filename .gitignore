# ---------------------------------------------------------------------------
# Secrets. Copy backend/api/.env.example to backend/api/.env and fill it in.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
.angular/
*.exe
# Go API binaries
backend/api/bin/
# Kiosk: the agent binary and the built display are produced by
# kiosk/kiosk-electron-shell/build.js (npm run dist) or by kiosk/run-kiosk.js
kiosk/kiosk-electron-shell/bin/
kiosk/kiosk-electron-shell/www/

# ---------------------------------------------------------------------------
# Runtime data (downloaded or written while running)
# ---------------------------------------------------------------------------
kiosk/local-store/
kiosk/tv-sync-agent-go/local-store/
backend/local-store/
kiosk/.run-kiosk-backup/
*.mp4
*.png
*.jpg

# ---------------------------------------------------------------------------
# Local and editor files
# ---------------------------------------------------------------------------
/.vscode/
.DS_Store
Thumbs.db
*.log
*.bak
# Data exports saved at the repository root
/*.csv

# ---------------------------------------------------------------------------
# Railway deployment files (kept locally for reference; not used to deploy this project)
# ---------------------------------------------------------------------------
.railwayignore
docs/DEPLOY_RAILWAY.md
